{
  "name": "weblua",
  "version": "0.1.0",
  "description": "A fast client-side Lua and Luau playground.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "worker:dev": "wrangler dev --config wrangler.toml",
    "worker:deploy": "wrangler deploy --config wrangler.toml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PytechNo/Weblua.git"
  },
  "keywords": [
    "lua",
    "luau",
    "playground",
    "wasm"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/PytechNo/Weblua/issues"
  },
  "homepage": "https://github.com/PytechNo/Weblua#readme",
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@sentry/react": "^10.64.0",
    "@uiw/react-codemirror": "^4.25.11",
    "luau-web": "^1.4.0",
    "lucide-react": "^1.24.0",
    "lz-string": "^1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "wasmoon": "^1.16.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.1"
  }
}
